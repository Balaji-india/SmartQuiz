# Copy to .env and fill in. Never commit .env.

# --- AI (both FREE, no credit card) ---
# Generator = Google Gemini free tier. Key from https://aistudio.google.com -> "Get API key". Paste after the = sign.
GEMINI_API_KEY=
GENERATOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_GENERATOR_MODEL=gemini-3.6-flash
# Checker (verification gates) = Groq free tier, a different model family on purpose. Key from https://console.groq.com/keys
# Emergency only, if Groq hits its daily cap: point these three at a second Gemini model (the Gemini key goes in GROQ_API_KEY). The metrics page then shows a warning. See SPEC section 4.
GROQ_API_KEY=
CHECKER_BASE_URL=https://api.groq.com/openai/v1
LLM_CHECKER_MODEL=openai/gpt-oss-120b
# Free-tier speed limits (requests per minute). provider.py throttles to stay under them.
GENERATOR_RPM=8
CHECKER_RPM=25
CHECKER_TPM=7000

# --- Database (matches docker-compose, nothing to change) ---
DATABASE_URL=postgresql+psycopg://smartquiz:smartquiz@localhost:5432/smartquiz

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Chain (Polygon Amoy testnet, chain id 80002). Test POL is free; if no faucet works, keep CHAIN_OPTIONAL=true and use a local Hardhat node (SPEC section 6) ---
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# Backup RPC if the one above fails: https://rpc-amoy.polygon.technology
# Paste the PRIVATE KEY of the new testnet-only MetaMask account (starts with 0x). Never a wallet with real money.
ISSUER_PRIVATE_KEY=
# Leave empty: deploying with --network amoy fills this. Local deploys only print their address.
REGISTRY_ADDRESS=
# true while building: a failed chain call logs a warning and the UI shows a "chain offline" badge. Set false for the live demo.
CHAIN_OPTIONAL=true

# --- Chat (P07 calibrates this and writes it to .env and .env.example) ---
CHAT_MIN_SIM=0.5

# --- Web (copied to web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
