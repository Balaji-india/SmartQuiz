# Copy to .env and fill in. Never commit .env.

# --- AI (FREE, no credit card) ---
# Generator and checker both run on Groq, using DIFFERENT model families on purpose. Key from https://console.groq.com/keys
GROQ_API_KEY=
GENERATOR_BASE_URL=https://api.groq.com/openai/v1
LLM_GENERATOR_MODEL=openai/gpt-oss-120b
CHECKER_BASE_URL=https://api.groq.com/openai/v1
LLM_CHECKER_MODEL=qwen/qwen3.8-27b
# Optional: Gemini as the generator. Set GENERATOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# and LLM_GENERATOR_MODEL to a Gemini model, then fill this key (https://aistudio.google.com). Its free tier can be as low
# as 20 requests per day per model, so check https://ai.dev/rate-limit first and lower the limits below to match.
GEMINI_API_KEY=
# Free-tier limits per model. provider.py throttles to stay under them, and the daily budget stops work before a request is sent.
GENERATOR_RPM=25
GENERATOR_TPM=8000
GENERATOR_REQUESTS_PER_DAY=1000
CHECKER_RPM=25
CHECKER_TPM=8000
CHECKER_REQUESTS_PER_DAY=1000
# Largest reply per request. Groq's free tier allows the checker model only 1000 output tokens per minute. 0 = provider default.
GENERATOR_MAX_TOKENS=0
CHECKER_MAX_TOKENS=1000
# reasoning_effort per role, sent only when set. gpt-oss with the default effort can spend its whole output on
# reasoning and return empty JSON (Groq json_validate_failed) or stop after a few facts; "low" fixes that.
GENERATOR_REASONING_EFFORT=low
CHECKER_REASONING_EFFORT=

# --- Database (matches docker-compose, nothing to change) ---
DATABASE_URL=postgresql+psycopg://smartquiz:smartquiz@localhost:5432/smartquiz

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Chain (Polygon Amoy testnet, chain id 80002). Test POL is free; if no faucet works, keep CHAIN_OPTIONAL=true and use a local Hardhat node (SPEC section 6) ---
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# Backup RPC if the one above fails: https://rpc-amoy.polygon.technology
# Paste the PRIVATE KEY of the new testnet-only MetaMask account (starts with 0x). Never a wallet with real money.
ISSUER_PRIVATE_KEY=
# Leave empty: deploying with --network amoy fills this. Local deploys only print their address.
REGISTRY_ADDRESS=
# true while building: a failed chain call logs a warning and the UI shows a "chain offline" badge. Set false for the live demo.
CHAIN_OPTIONAL=true

# --- Chat (P07 calibrates this and writes it to .env and .env.example) ---
# CHAT_MIN_SIM calibrated on samples/sample.pdf: in-scope best similarity 0.75–0.89, out-of-scope 0.40–0.63
CHAT_MIN_SIM=0.69

# --- Web (copied to web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
